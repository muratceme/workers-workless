# Bu dosyanın adını .env yapın ve kendi anahtarınızı yazın. .env dosyasını kimseyle paylaşmayın.

# Sağlayıcı: anthropic | openai | ollama (ollama = yerel model, veri bilgisayardan çıkmaz)
WW_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=buraya-kendi-anahtariniz
# WW_MODEL=claude-opus-5-5
# WW_EFFORT=medium

# OpenAI kullanacaksanız
# OPENAI_API_KEY=buraya-kendi-anahtariniz
# WW_MODEL=model-adi

# Ollama kullanacaksanız
# OLLAMA_HOST=http://localhost:11434
# WW_MODEL=model-adi
